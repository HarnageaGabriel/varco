{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {"name": "web", "namespace": "apps"},
      "spec": {
        "rules": [
          {
            "host": "web.example.test",
            "http": {
              "paths": [
                {"path": "/", "pathType": "Prefix", "backend": {"service": {"name": "web", "port": {"number": 80}}}}
              ]
            }
          }
        ]
      }
    }
  ]
}
