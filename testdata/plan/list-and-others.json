{
  "apiVersion": "v1",
  "kind": "List",
  "metadata": {
    "annotations": {
      "varco.dev/source": "https://kubernetes.io/blog/2026/02/27/ingress-nginx-before-you-migrate"
    }
  },
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": { "namespace": "ops", "name": "settings" },
      "data": { "retries": "3" }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "namespace": "ops",
        "name": "status-page",
        "annotations": {
          "nginx.ingress.kubernetes.io/force-ssl-redirect": "true"
        }
      },
      "spec": {
        "ingressClassName": "nginx",
        "rules": [
          {
            "host": "status.example.com",
            "http": {
              "paths": [
                {
                  "path": "/status",
                  "pathType": "Prefix",
                  "backend": {
                    "service": { "name": "status", "port": { "number": 80 } }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": { "namespace": "ops", "name": "ignored" }
    }
  ]
}

